# --- FastESM ---------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored — never commit secrets.

FASTESM_ADMIN_EMAIL=admin@fastesm.example
FASTESM_ADMIN_PASSWORD=FastESM2026$
FASTESM_SECRET=
FASTESM_PORT=5015
FASTESM_ENV_LABEL=FastESM
# Blank => ./fastesm.sqlite. In Docker point at the mounted volume.
FASTESM_DB=

# --- AI assistant ----------------------------------------------------------
# Free-form chat uses one provider; slash-commands (/sla, /approvals …) need no key.
#   MODEL_PROVIDER: xai | openai | anthropic | google
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://esm.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# FastSME local accounts and transactional email
FASTSME_AUTH_DB=
FASTSME_PUBLIC_URL=https://esm.fastsme.com
POSTMARK_API_TOKEN=
FROM_EMAIL=info@predictivelabs.ai

# Public reads need no credential; set this to enable bearer-token API writes.
FASTSME_API_TOKEN=
